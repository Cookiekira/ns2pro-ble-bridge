[Unit]
Description=NS2Pro BLE Bridge USB/IP client attachment
Requires=ns2pro-ble-bridge.service
BindsTo=ns2pro-ble-bridge.service
After=ns2pro-ble-bridge.service
PartOf=ns2pro-ble-bridge.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/libexec/ns2pro-ble-bridge-usbip-attach
RemainAfterExit=yes
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=ns2pro-ble-bridge.service
