[Unit]
Description=NS2Pro BLE Bridge
Wants=bluetooth.service
After=bluetooth.service

[Service]
Type=simple
User=root
WorkingDirectory=/var/lib/ns2pro-ble-bridge
ExecStartPre=/sbin/modprobe vhci_hcd
ExecStart=/usr/local/libexec/Ns2Pro.BleBridge
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s

[Install]
WantedBy=multi-user.target
