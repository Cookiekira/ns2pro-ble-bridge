#!/bin/sh
set -eu

host="${NS2PRO_USBIP_HOST:-127.0.0.1}"
port="${NS2PRO_USBIP_PORT:-3241}"
usbip="$(command -v usbip || true)"

if [ -z "$usbip" ]; then
    echo "usbip command not found" >&2
    exit 1
fi

attempt=0
while [ "$attempt" -lt 60 ]; do
    exports="$($usbip --tcp-port "$port" list -r "$host" 2>/dev/null || true)"
    busid="$(printf '%s\n' "$exports" | awk '$1 ~ /^[0-9]+-[0-9]+:$/ && /057e:2069/ {sub(/:$/, "", $1); print $1; exit}')"

    if [ -n "$busid" ]; then
        exec "$usbip" --tcp-port "$port" attach -r "$host" -b "$busid"
    fi

    attempt=$((attempt + 1))
    sleep 1
done

echo "NS2Pro USB/IP export did not become available on $host:$port" >&2
exit 1
