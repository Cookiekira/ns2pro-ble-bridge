<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows')))">net10.0-windows10.0.26100.0</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultItemExcludes>$(DefaultItemExcludes);vendor/**;Tests/**</DefaultItemExcludes>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimMode>full</TrimMode>
    <OptimizationPreference>Speed</OptimizationPreference>
    <ViiperSourceRoot Condition="'$(ViiperSourceRoot)' == ''">$(VIIPER_SOURCE_ROOT)</ViiperSourceRoot>
    <ViiperSourceRoot Condition="'$(ViiperSourceRoot)' == ''">$(MSBuildProjectDirectory)/vendor/VIIPER</ViiperSourceRoot>
    <ViiperLibraryFile Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-')) Or $([System.String]::Copy('$(TargetFramework)').Contains('-windows'))">libVIIPER.dll</ViiperLibraryFile>
    <ViiperLibraryFile Condition="'$(ViiperLibraryFile)' == ''">libVIIPER.so</ViiperLibraryFile>
    <ViiperLibraryDir>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)/viiper-native/</ViiperLibraryDir>
    <ViiperLibrary>$(ViiperLibraryDir)$(ViiperLibraryFile)</ViiperLibrary>
    <ViiperResourceName>Ns2Pro.BleBridge.Native.$(ViiperLibraryFile)</ViiperResourceName>
    <BuildViiperLibrary Condition="'$(BuildViiperLibrary)' == ''">true</BuildViiperLibrary>
  </PropertyGroup>

  <ItemGroup Condition="!$([System.String]::Copy('$(TargetFramework)').Contains('-windows'))">
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.0" />
    <PackageReference Include="Tmds.DBus.Generator" Version="0.95.0" PrivateAssets="all" />
    <AdditionalFiles Include="Bluetooth/Bluez/bluez.xml" Namespace="Ns2Pro.BleBridge.Bluez" DBusGeneratorMode="Proxy" />
  </ItemGroup>

  <ItemGroup Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-windows'))">
    <Compile Remove="Bluetooth/Bluez/**/*.cs" />
  </ItemGroup>

  <Target Name="BuildViiperLibrary" BeforeTargets="AssignTargetPaths" Condition="'$(BuildViiperLibrary)' == 'true'">
    <Error Condition="!Exists('$(ViiperSourceRoot)/go.mod') Or !Exists('$(ViiperSourceRoot)/lib/viiper')"
           Text="VIIPER source was not found at $(ViiperSourceRoot). Run 'git submodule update --init --recursive' or set VIIPER_SOURCE_ROOT /p:ViiperSourceRoot=&lt;path-to-VIIPER&gt;." />
    <MakeDir Directories="$(ViiperLibraryDir)" />
    <Exec WorkingDirectory="$(ViiperSourceRoot)"
          EnvironmentVariables="CGO_ENABLED=1"
          Command="go build -buildmode=c-shared -trimpath -o &quot;$(ViiperLibrary)&quot; ./lib/viiper" />
  </Target>

  <ItemGroup Condition="'$(BuildViiperLibrary)' == 'true'">
    <EmbeddedResource Include="$(ViiperLibrary)" LogicalName="$(ViiperResourceName)" />
  </ItemGroup>
</Project>
