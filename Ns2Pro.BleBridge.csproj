<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimMode>full</TrimMode>
    <OptimizationPreference>Speed</OptimizationPreference>
    <AssemblyName>Ns2Pro.BleBridge</AssemblyName>
    <RootNamespace>Ns2Pro.BleBridge</RootNamespace>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\..\VIIPER\dist\libVIIPER\libVIIPER.dll')">
    <EmbeddedResource Include="$(MSBuildProjectDirectory)\..\VIIPER\dist\libVIIPER\libVIIPER.dll"
                      LogicalName="Ns2Pro.BleBridge.Native.libVIIPER.dll" />
  </ItemGroup>
</Project>
